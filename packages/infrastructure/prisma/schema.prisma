// Every table carries tenant_id and every query is scoped by it, so a
// self-hosted deployment can become multi-tenant without a data migration.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum EntityKind {
  PF
  PJ
}

enum TaxRegime {
  SIMPLES_NACIONAL
  MEI
  LUCRO_PRESUMIDO
  LUCRO_REAL
}

enum AccountType {
  CHECKING
  SAVINGS
  CREDIT_CARD
  INVESTMENT
  WALLET
}

enum AccountOrigin {
  CONNECTED
  MANUAL
}

enum BillKind {
  BOLETO
  PIX_KEY
  PIX_QR
  TAX_BARCODE
  DARF_NO_BARCODE
}

enum BillStatus {
  OPEN
  NEEDS_CONFIRMATION
  PROCESSING
  AWAITING_BANK_APPROVAL
  ASSISTED
  PAID
  CANCELLED
}

enum BillSource {
  GMAIL
  SHARE
  CAMERA
  CHAT
  DDA
  MANUAL
}

enum PaidBy {
  RAIL
  USER
  STATEMENT
}

enum RailId {
  MERCADO_PAGO_PAYOUTS
  ASAAS
  INTER_EMPRESAS
  C6_EMPRESAS
  ASSISTED
}

enum StepMode {
  AUTOMATIC
  BANK_APPROVAL
  ASSISTED
}

enum PaymentMethod {
  PIX
  BOLETO
}

enum AttemptOutcome {
  PAID
  SUBMITTED
  PENDING_APPROVAL
  ASSISTED
  FAILED
  IN_FLIGHT
}

enum FundingStatus {
  IN_FLIGHT
  SUBMITTED
  PAID
  NOT_NEEDED
  FAILED
}

enum InvoiceStatus {
  DRAFT
  PROCESSING
  ISSUED
  REJECTED
  CANCELLED
}

enum CardBillStatus {
  OPEN
  CLOSED
  PAID
}

enum InvestmentKind {
  FIXED_INCOME
  FUND
  EQUITY
  ETF
  PENSION
  STRUCTURED
  OTHER
}

enum InvestmentStatus {
  ACTIVE
  PENDING
  CLOSED
}

enum InvestmentMovementKind {
  BUY
  SELL
  INCOME
  TAX
  TRANSFER
  OTHER
}

enum CategorizedBy {
  RULE
  AI
  USER
}

model Tenant {
  id        String   @id
  name      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("tenants")
}

model User {
  id           String   @id
  tenantId     String   @map("tenant_id")
  email        String
  passwordHash String?  @map("password_hash")
  locale       String   @default("pt-BR")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([tenantId, email])
  @@map("users")
}

model FinancialEntity {
  id        String     @id
  tenantId  String     @map("tenant_id")
  kind      EntityKind
  name      String
  taxId     String     @map("tax_id")
  taxRegime TaxRegime? @map("tax_regime")
  createdAt DateTime   @default(now()) @map("created_at")

  accounts Account[]
  bills    Bill[]

  @@unique([tenantId, taxId])
  @@map("financial_entities")
}

model Institution {
  id           String  @id
  tenantId     String  @map("tenant_id")
  name         String
  code         String?
  manual       Boolean @default(false)
  connectorId  Int?    @map("connector_id")
  imageUrl     String? @map("image_url")
  primaryColor String? @map("primary_color")

  @@unique([tenantId, name])
  @@map("institutions")
}

model Connection {
  id            String    @id
  tenantId      String    @map("tenant_id")
  entityId      String    @map("entity_id")
  institutionId String    @map("institution_id")
  provider      String
  itemId        String    @map("item_id")
  status        String
  lastSyncAt    DateTime? @map("last_sync_at")

  @@unique([tenantId, provider, itemId])
  @@map("connections")
}

model Account {
  id                   String        @id
  tenantId             String        @map("tenant_id")
  entityId             String        @map("entity_id")
  institutionId        String        @map("institution_id")
  connectionId         String?       @map("connection_id")
  externalId           String?       @map("external_id")
  name                 String
  type                 AccountType
  origin               AccountOrigin
  isReserve            Boolean       @default(false) @map("is_reserve")
  balanceCents         BigInt        @default(0) @map("balance_cents")
  currency             String        @default("BRL") @db.Char(3)
  cdiPercent           Int?          @map("cdi_percent")
  numberSuffix         String?       @map("number_suffix")
  // A card's credit line, all null on cash accounts.
  creditLimitCents     BigInt?       @map("credit_limit_cents")
  creditAvailableCents BigInt?       @map("credit_available_cents")
  creditClosesOn       DateTime?     @map("credit_closes_on") @db.Date
  creditDueOn          DateTime?     @map("credit_due_on") @db.Date
  creditBrand          String?       @map("credit_brand")
  creditOpenBillCents  BigInt?       @map("credit_open_bill_cents")

  entity       FinancialEntity @relation(fields: [entityId], references: [id])
  transactions Transaction[]

  @@index([tenantId, entityId])
  @@map("accounts")
}

model Transaction {
  id                 String         @id
  tenantId           String         @map("tenant_id")
  accountId          String         @map("account_id")
  externalId         String?        @map("external_id")
  amountCents        BigInt         @map("amount_cents")
  currency           String         @db.Char(3)
  bookedOn           DateTime       @map("booked_on") @db.Date
  description        String
  categoryId         String?        @map("category_id")
  transferGroupId    String?        @map("transfer_group_id")
  invoiceId          String?        @map("invoice_id")
  note               String?
  categorizedBy      CategorizedBy? @map("categorized_by")
  categoryConfidence Float?         @map("category_confidence")
  merchant           String?
  counterparty       String?
  installmentNumber  Int?           @map("installment_number")
  installmentCount   Int?           @map("installment_count")
  purchaseOn         DateTime?      @map("purchase_on") @db.Date

  account Account @relation(fields: [accountId], references: [id])

  @@unique([tenantId, accountId, externalId])
  @@index([tenantId, bookedOn])
  @@index([tenantId, categoryId])
  @@map("transactions")
}

model Category {
  id       String  @id
  tenantId String  @map("tenant_id")
  key      String?
  name     String
  parentId String? @map("parent_id")
  icon     String?

  @@unique([tenantId, name])
  @@map("categories")
}

model CategoryRule {
  id         String   @id
  tenantId   String   @map("tenant_id")
  entityId   String?  @map("entity_id")
  pattern      String
  counterparty String?
  categoryId   String   @map("category_id")
  priority     Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([tenantId])
  @@map("category_rules")
}

model Budget {
  id         String  @id
  tenantId   String  @map("tenant_id")
  entityId   String  @map("entity_id")
  categoryId String  @map("category_id")
  month      String  @db.Char(7)
  limitCents BigInt  @map("limit_cents")
  rollover   Boolean @default(false)

  @@unique([tenantId, entityId, categoryId, month])
  @@map("budgets")
}

model Recurrence {
  id          String    @id
  tenantId    String    @map("tenant_id")
  entityId    String    @map("entity_id")
  // The normalized words of the charge description that match its repeats.
  key         String
  description String
  amountCents BigInt    @map("amount_cents")
  dayOfMonth  Int       @map("day_of_month")
  confirmed   Boolean   @default(false)
  dismissed   Boolean   @default(false)
  lastSeenOn  DateTime? @map("last_seen_on") @db.Date

  @@unique([tenantId, entityId, key])
  @@index([tenantId, entityId])
  @@map("recurrences")
}

model CreditCardBill {
  id           String         @id
  tenantId     String         @map("tenant_id")
  accountId    String         @map("account_id")
  externalId   String?        @map("external_id")
  closingDate  DateTime?      @map("closing_date") @db.Date
  dueDate      DateTime       @map("due_date") @db.Date
  totalCents   BigInt         @map("total_cents")
  minimumCents BigInt?        @map("minimum_cents")
  currency     String         @default("BRL") @db.Char(3)
  status       CardBillStatus @default(CLOSED)

  @@unique([tenantId, accountId, dueDate])
  @@map("credit_card_bills")
}

// A position an Open Finance item reports, refreshed on every sync. The
// balance is net of taxes and fees.
model Investment {
  id                   String               @id
  tenantId             String               @map("tenant_id")
  entityId             String               @map("entity_id")
  connectionId         String               @map("connection_id")
  institutionId        String               @map("institution_id")
  externalId           String               @map("external_id")
  name                 String
  kind                 InvestmentKind
  subtype              String?
  issuer               String?
  status               InvestmentStatus
  balanceCents         BigInt               @map("balance_cents")
  investedCents        BigInt?              @map("invested_cents")
  profitCents          BigInt?              @map("profit_cents")
  currency             String               @default("BRL") @db.Char(3)
  quantity             Float?
  ratePercent          Float?               @map("rate_percent")
  rateIndex            String?              @map("rate_index")
  fixedAnnualRate      Float?               @map("fixed_annual_rate")
  lastMonthRate        Float?               @map("last_month_rate")
  lastTwelveMonthsRate Float?               @map("last_twelve_months_rate")
  dueOn                DateTime?            @map("due_on") @db.Date
  valuedOn             DateTime?            @map("valued_on") @db.Date
  syncedAt             DateTime             @map("synced_at")
  movements            InvestmentMovement[]
  snapshots            InvestmentSnapshot[]

  @@unique([tenantId, connectionId, externalId])
  @@index([tenantId, entityId])
  @@map("investments")
}

model InvestmentMovement {
  id           String                 @id
  tenantId     String                 @map("tenant_id")
  investmentId String                 @map("investment_id")
  externalId   String                 @map("external_id")
  kind         InvestmentMovementKind
  occurredOn   DateTime               @map("occurred_on") @db.Date
  amountCents  BigInt                 @map("amount_cents")
  quantity     Float?
  unitPrice    Float?                 @map("unit_price")
  investment   Investment             @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@unique([investmentId, externalId])
  @@index([tenantId, investmentId])
  @@map("investment_movements")
}

model InvestmentSnapshot {
  tenantId     String     @map("tenant_id")
  investmentId String     @map("investment_id")
  day          DateTime   @db.Date
  balanceCents BigInt     @map("balance_cents")
  estimated    Boolean    @default(false)
  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@id([investmentId, day])
  @@index([tenantId, day])
  @@map("investment_snapshots")
}

model IndexRate {
  index String
  day   DateTime @db.Date
  rate  Float

  @@id([index, day])
  @@map("index_rates")
}

model Holding {
  id         String   @id
  tenantId   String   @map("tenant_id")
  accountId  String   @map("account_id")
  ticker     String?
  name       String
  quantity   Decimal  @db.Decimal(20, 8)
  valueCents BigInt   @map("value_cents")
  asOf       DateTime @map("as_of")

  @@index([tenantId, accountId])
  @@map("holdings")
}

model Goal {
  id          String    @id
  tenantId    String    @map("tenant_id")
  entityId    String    @map("entity_id")
  name        String
  targetCents BigInt    @map("target_cents")
  deadline    DateTime? @db.Date
  accountId   String?   @map("account_id")

  @@index([tenantId, entityId])
  @@map("goals")
}

model Bill {
  id          String     @id
  tenantId    String     @map("tenant_id")
  entityId    String     @map("entity_id")
  kind        BillKind
  status      BillStatus
  source      BillSource
  payee       String?
  amountCents BigInt     @map("amount_cents")
  currency    String     @default("BRL") @db.Char(3)
  dueDate     DateTime   @map("due_date") @db.Date
  code        String?
  pixCode     String?    @map("pix_code")
  createdAt   DateTime   @map("created_at")
  paidAt      DateTime?  @map("paid_at")
  paidBy      PaidBy?    @map("paid_by")

  entity   FinancialEntity  @relation(fields: [entityId], references: [id])
  plan     PaymentPlan?
  attempts PaymentAttempt[]

  // One live bill per Pix code: a bolepix half that arrives later is attached, not added.
  @@unique([tenantId, entityId, pixCode], where: raw("pix_code IS NOT NULL AND status <> 'CANCELLED'"))
  @@index([tenantId, entityId, status])
  @@index([tenantId, entityId, code])
  @@map("bills")
}

model PaymentPlan {
  billId      String @id @map("bill_id")
  tenantId    String @map("tenant_id")
  steps       Json
  currentStep Int    @map("current_step")

  bill Bill @relation(fields: [billId], references: [id])

  @@index([tenantId])
  @@map("payment_plans")
}

model PaymentAttempt {
  id             String         @id
  tenantId       String         @map("tenant_id")
  billId         String         @map("bill_id")
  stepIndex      Int            @map("step_index")
  rail           RailId
  mode           StepMode
  method         PaymentMethod  @default(BOLETO)
  amountCents    BigInt         @map("amount_cents")
  outcome        AttemptOutcome
  reason         String?
  externalId     String?        @map("external_id")
  idempotencyKey String         @map("idempotency_key")
  at             DateTime

  bill Bill @relation(fields: [billId], references: [id])

  @@index([tenantId, billId])
  @@index([tenantId, rail, at])
  @@index([tenantId, idempotencyKey])
  @@map("payment_attempts")
}

model ReserveFunding {
  id              String        @id
  tenantId        String        @map("tenant_id")
  entityId        String        @map("entity_id")
  day             DateTime      @db.Date
  round           Int
  billIds         String[]      @map("bill_ids")
  billsTotalCents BigInt        @map("bills_total_cents")
  availableCents  BigInt?       @map("available_cents")
  amountCents     BigInt        @map("amount_cents")
  currency        String        @default("BRL") @db.Char(3)
  status          FundingStatus
  reason          String?
  externalId      String?       @map("external_id")
  idempotencyKey  String        @map("idempotency_key")
  at              DateTime

  @@unique([tenantId, entityId, day, round])
  @@unique([tenantId, idempotencyKey])
  @@map("reserve_fundings")
}

model Payee {
  tenantId String   @map("tenant_id")
  entityId String   @map("entity_id")
  key      String
  firstAt  DateTime @default(now()) @map("first_at")

  @@id([tenantId, entityId, key])
  @@map("payees")
}

model PaymentSettings {
  tenantId            String   @map("tenant_id")
  entityId            String   @map("entity_id")
  killSwitch          Boolean  @default(false) @map("kill_switch")
  enabledRails        RailId[] @map("enabled_rails")
  dailyCapCents       Json     @default("{}") @map("daily_cap_cents")
  confirmAboveCents   BigInt?  @map("confirm_above_cents")
  entityDailyCapCents BigInt?  @default(1000000) @map("entity_daily_cap_cents")
  paymentCapCents     BigInt?  @default(500000) @map("payment_cap_cents")
  maxDeviationPercent Int?     @default(30) @map("max_deviation_percent")
  approvalCutoff      String   @default("16:00") @map("approval_cutoff")

  @@id([tenantId, entityId])
  @@map("payment_settings")
}

model InvoiceClient {
  id       String  @id
  tenantId String  @map("tenant_id")
  entityId String  @map("entity_id")
  name     String
  taxId    String? @map("tax_id")
  country  String  @default("BR") @db.Char(2)
  email    String?

  @@index([tenantId, entityId])
  @@map("invoice_clients")
}

model InvoiceTemplate {
  id          String   @id
  tenantId    String   @map("tenant_id")
  entityId    String   @map("entity_id")
  clientId    String   @map("client_id")
  serviceCode String   @map("service_code")
  description String
  amountCents BigInt   @map("amount_cents")
  currency    String   @db.Char(3)
  // FIXED bills amount_cents; HOURLY bills amount_cents per hour times hours.
  billing     String   @default("FIXED")
  hours       Decimal? @db.Decimal(8, 2)
  dayOfMonth  Int      @map("day_of_month")
  active      Boolean  @default(true)

  @@index([tenantId, entityId])
  @@map("invoice_templates")
}

model Invoice {
  id           String        @id
  tenantId     String        @map("tenant_id")
  entityId     String        @map("entity_id")
  clientId     String        @map("client_id")
  templateId   String?       @map("template_id")
  issuer       String
  externalId   String?       @map("external_id")
  number       String?
  status       InvoiceStatus
  amountCents  BigInt        @map("amount_cents")
  currency     String        @db.Char(3)
  fxRate       Decimal?      @map("fx_rate") @db.Decimal(18, 8)
  isExport     Boolean       @default(false) @map("is_export")
  competence   String        @db.Char(7)
  issueOn      DateTime      @default(dbgenerated("CURRENT_DATE")) @map("issue_on") @db.Date
  description  String        @default("")
  serviceCode  String        @default("") @map("service_code")
  pdfUrl       String?       @map("pdf_url")
  xmlUrl       String?       @map("xml_url")
  cancelReason String?       @map("cancel_reason")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([tenantId, entityId, competence])
  @@index([tenantId, externalId])
  @@map("invoices")
}

// PDF and XML of an issued invoice, downloaded from the issuer once.
model InvoiceFile {
  tenantId  String   @map("tenant_id")
  invoiceId String   @map("invoice_id")
  kind      String
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  size      Int
  bytes     Bytes
  createdAt DateTime @map("created_at")

  @@id([tenantId, invoiceId, kind])
  @@map("invoice_files")
}

model TaxGuide {
  id         String   @id
  tenantId   String   @map("tenant_id")
  entityId   String   @map("entity_id")
  kind       String
  competence String   @db.Char(7)
  dueDate    DateTime @map("due_date") @db.Date
  billId     String?  @map("bill_id")

  @@unique([tenantId, entityId, kind, competence])
  @@map("tax_guides")
}

model InternalTransfer {
  id            String   @id
  tenantId      String   @map("tenant_id")
  kind          String
  amountCents   BigInt   @map("amount_cents")
  currency      String   @db.Char(3)
  at            DateTime
  rail          String
  fromAccountId String   @map("from_account_id")
  toAccountId   String   @map("to_account_id")
  document      String?

  @@index([tenantId, at])
  @@map("internal_transfers")
}

model BillAttachment {
  id        String   @id
  tenantId  String   @map("tenant_id")
  billId    String   @map("bill_id")
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  size      Int
  bytes     Bytes
  createdAt DateTime @map("created_at")

  @@index([tenantId, billId])
  @@map("bill_attachments")
}

// Small per-tenant documents read whole: settings, drafts and export records.
model Document {
  tenantId   String   @map("tenant_id")
  collection String
  id         String
  data       Json
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@id([tenantId, collection, id])
  @@map("documents")
}

model Alert {
  id        String    @id
  tenantId  String    @map("tenant_id")
  type      String
  entityId  String?   @map("entity_id")
  billId    String?   @map("bill_id")
  invoiceId String?   @map("invoice_id")
  title     String
  body      String
  data      Json      @default("{}")
  dedupeKey String?   @map("dedupe_key")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, dedupeKey])
  @@index([tenantId, createdAt])
  @@index([tenantId, readAt])
  @@map("alerts")
}

model DeviceToken {
  token      String   @id
  tenantId   String   @map("tenant_id")
  platform   String
  locale     String   @default("pt")
  createdAt  DateTime @default(now()) @map("created_at")
  lastSeenAt DateTime @map("last_seen_at")

  @@index([tenantId])
  @@map("device_tokens")
}

model AuditEvent {
  id        String   @id
  tenantId  String   @map("tenant_id")
  actor     String
  action    String
  subjectId String   @map("subject_id")
  rail      RailId?
  result    String
  details   Json     @default("{}")
  at        DateTime
  actorId   String?  @map("actor_id")
  requestId String?  @map("request_id")

  @@index([tenantId, subjectId])
  @@map("audit_events")
}

// Provider events already received, so a replay is ignored, with what each
// named and what handling it came to.
model WebhookEvent {
  tenantId    String    @map("tenant_id")
  provider    String
  eventId     String    @map("event_id")
  receivedAt  DateTime  @map("received_at")
  type        String?
  // The item, payment reference or invoice the event names.
  subjectId   String?   @map("subject_id")
  outcome     String?
  reason      String?
  processedAt DateTime? @map("processed_at")

  @@id([tenantId, provider, eventId])
  @@index([receivedAt])
  @@map("webhook_events")
}

model IdempotencyRecord {
  tenantId  String   @map("tenant_id")
  key       String
  scope     String
  result    Json
  createdAt DateTime @default(now()) @map("created_at")

  @@id([tenantId, key])
  @@map("idempotency_records")
}

model Secret {
  tenantId  String   @map("tenant_id")
  name      String
  sealed    String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([tenantId, name])
  @@map("secrets")
}

model ChatThread {
  id        String   @id
  tenantId  String   @map("tenant_id")
  scope     String   @default("ALL")
  title     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  messages ChatMessage[]

  @@index([tenantId])
  @@index([tenantId, updatedAt])
  @@map("chat_threads")
}

model ChatMessage {
  id        String                      @id
  tenantId  String                      @map("tenant_id")
  threadId  String                      @map("thread_id")
  role      String
  content   String
  toolCalls Json?                       @map("tool_calls")
  notice    String?
  embedding Unsupported("vector(768)")?
  createdAt DateTime                    @default(now()) @map("created_at")

  thread ChatThread @relation(fields: [threadId], references: [id])

  @@index([tenantId, threadId])
  @@map("chat_messages")
}

model ChatAttachment {
  id        String   @id
  tenantId  String   @map("tenant_id")
  threadId  String   @map("thread_id")
  messageId String   @map("message_id")
  fileName  String   @map("file_name")
  mimeType  String   @map("mime_type")
  size      Int
  bytes     Bytes
  createdAt DateTime @map("created_at")

  @@index([tenantId, threadId])
  @@map("chat_attachments")
}

model ChatAction {
  id          String      @id
  tenantId    String      @map("tenant_id")
  threadId    String      @map("thread_id")
  messageId   String      @map("message_id")
  tool        String
  status      String
  entity      EntityKind?
  needsEntity Boolean     @default(false) @map("needs_entity")
  target      Json        @default("{}")
  details     Json        @default("{}")
  result      Json?
  error       String?
  createdAt   DateTime    @map("created_at")
  resolvedAt  DateTime?   @map("resolved_at")

  @@index([tenantId, threadId])
  @@map("chat_actions")
}
