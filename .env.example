# Copy to .env and fill in. Never commit the real file.

# Database (Neon Postgres). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://user:password@host/cashdeck?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/cashdeck?sslmode=require"

# Self-hosted tenant served by this deployment.
CASHDECK_TENANT_ID="local"

# Base64 encoded 32 byte key that wraps every stored secret (SecretVault).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CASHDECK_MASTER_KEY=""

# Session signing secret.
AUTH_SECRET=""

# Adapters. Leave empty to keep the fake or assisted behaviour.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
MERCADO_PAGO_ACCESS_TOKEN=""
ASAAS_API_KEY=""
ASAAS_BASE_URL="https://api-sandbox.asaas.com/v3"
INTER_CLIENT_ID=""
INTER_CLIENT_SECRET=""
C6_CLIENT_ID=""
C6_CLIENT_SECRET=""
NOTAAS_API_KEY=""
GEMINI_API_KEY=""

# API access: the mobile app signs in with this token (16+ characters)
CASHDECK_API_TOKEN=
CASHDECK_SERVER_NAME=Cashdeck
CASHDECK_APP_SCHEME=cashdeck
# Vercel sends it as a bearer token to /api/cron/*
CRON_SECRET=
SENTRY_DSN=

# AI (card statements, shared bills)
LLM_PROVIDER=
GEMINI_MODEL_ID=
AI_GATEWAY_API_KEY=
AI_GATEWAY_FALLBACK_MODEL=
BRL_PER_USD=

# Payment rails, tenant-wide fallback when the app has not stored credentials
ASAAS_ENVIRONMENT=
MERCADO_PAGO_ENVIRONMENT=
MERCADO_PAGO_SIGNING_KEY=
INTER_ENVIRONMENT=
INTER_ACCOUNT=
INTER_CERT=
INTER_KEY=
C6_ENVIRONMENT=
C6_TOKEN_URL=
C6_CERT=
C6_KEY=
C6_UPLOADER_NAME=

# Gmail capture: GMAIL_REDIRECT_URI is <api>/api/v1/capture/mailboxes/oauth/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Invoices (Notaas)
NOTAAS_WEBHOOK_SECRET=
NOTAAS_ALIQUOTA_ISS=
NOTAAS_LOCAL_PRESTACAO=
NOTAAS_EXPORT_COUNTRY=

# Push notifications
FCM_SERVICE_ACCOUNT_JSON=
