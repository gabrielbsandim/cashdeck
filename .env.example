# Copy to .env and fill in. Never commit the real file.

# Database (Neon Postgres). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://user:password@host/cashdeck?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/cashdeck?sslmode=require"

# Self-hosted tenant served by this deployment.
CASHDECK_TENANT_ID="local"

# Read once by db:seed to create the two entities; later edits go through
# PATCH /api/v1/entities/{id}. Tax ids digits only; regime SIMPLES_NACIONAL,
# MEI, LUCRO_PRESUMIDO or LUCRO_REAL.
CASHDECK_PF_NAME=""
CASHDECK_PF_TAX_ID=""
CASHDECK_PJ_NAME=""
CASHDECK_PJ_TAX_ID=""
CASHDECK_PJ_TAX_REGIME=""

# Base64 encoded 32 byte key that wraps every stored secret (SecretVault).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CASHDECK_MASTER_KEY=""

# Adapters. Leave empty to keep the fake or assisted behaviour.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
MERCADO_PAGO_ACCESS_TOKEN=""
ASAAS_API_KEY=""
INTER_CLIENT_ID=""
INTER_CLIENT_SECRET=""
C6_CLIENT_ID=""
C6_CLIENT_SECRET=""
NOTAAS_API_KEY=""
GEMINI_API_KEY=""

# API access: the mobile app signs in with this token (16+ characters)
CASHDECK_API_TOKEN=
CASHDECK_SERVER_NAME=Cashdeck
CASHDECK_APP_SCHEME=cashdeck
# Vercel sends it as a bearer token to /api/cron/*
CRON_SECRET=
SENTRY_DSN=

# AI (card statements, shared bills, categorization, chat): gateway, gemini or fake
LLM_PROVIDER=
GEMINI_MODEL_ID=
AI_GATEWAY_API_KEY=
AI_GATEWAY_FALLBACK_MODEL=
BRL_PER_USD=
# AI chat: kill switch, daily quota per tenant, and the bounds of one turn
CHAT_ENABLED=true
CHAT_DAILY_TURN_LIMIT=100
CHAT_DAILY_COST_LIMIT_CENTS=200
CHAT_MAX_ROUNDS=6
CHAT_TURN_BUDGET_MS=25000

# Payment rails, tenant-wide fallback when the app has not stored credentials
ASAAS_ENVIRONMENT=
# Pix key of the Asaas account that pays personal bills; the reserve funding
# payout sends to it. Per entity as the sealed secret ASAAS_PIX_KEY@<entityId>.
ASAAS_PIX_KEY=
MERCADO_PAGO_ENVIRONMENT=
MERCADO_PAGO_SIGNING_KEY=
INTER_ENVIRONMENT=
INTER_ACCOUNT=
INTER_CERT=
INTER_KEY=
C6_ENVIRONMENT=
C6_TOKEN_URL=
C6_CERT=
C6_KEY=
C6_UPLOADER_NAME=

# Gmail capture: GMAIL_REDIRECT_URI is <api>/api/v1/capture/mailboxes/oauth/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Invoices (Notaas)
NOTAAS_WEBHOOK_SECRET=
NOTAAS_ALIQUOTA_ISS=
NOTAAS_LOCAL_PRESTACAO=
NOTAAS_EXPORT_COUNTRY=

# Webhook secrets (see docs/providers.md); NAME@<entityId> in the app wins
ASAAS_WEBHOOK_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
INTER_WEBHOOK_TOKEN=
PLUGGY_WEBHOOK_SECRET=

# Push notifications
FCM_SERVICE_ACCOUNT_JSON=
