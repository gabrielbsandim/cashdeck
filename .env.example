# Every variable Cashdeck reads, with empty or fake values. Never commit a filled copy.
#
# Where to put them:
#   apps/api/.env.local   the API dev server (pnpm -C apps/api dev)
#   .env (repo root)      Prisma migrations and the seed (packages/infrastructure)
#   Vercel project        the deployed API
#
# Only DATABASE_URL, CASHDECK_API_TOKEN, CASHDECK_MASTER_KEY and CRON_SECRET are
# required on a deployed server. Locally the API runs in memory with just
# CASHDECK_API_TOKEN. See docs/deploy.md for the full table.

# Database (Neon Postgres). Pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://user:password@host/cashdeck?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/cashdeck?sslmode=require"
# A disposable database for the Prisma integration tests; falls back to DATABASE_URL.
DATABASE_TEST_URL=

# Self-hosted tenant served by this deployment.
CASHDECK_TENANT_ID="local"

# Read once by db:seed to create the two entities; later edits go through
# PATCH /api/v1/entities/{id}. Tax ids digits only; regime SIMPLES_NACIONAL,
# MEI, LUCRO_PRESUMIDO or LUCRO_REAL. Empty values fall back to public test ids.
CASHDECK_PF_NAME=""
CASHDECK_PF_TAX_ID=""
CASHDECK_PJ_NAME=""
CASHDECK_PJ_TAX_ID=""
CASHDECK_PJ_TAX_REGIME=""

# Base64 encoded 32 byte key that wraps every stored secret (SecretVault).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CASHDECK_MASTER_KEY=""

# API access: the mobile app signs in with this token (16+ characters).
CASHDECK_API_TOKEN=
CASHDECK_SERVER_NAME=Cashdeck
CASHDECK_APP_SCHEME=cashdeck
# Vercel sends it as a bearer token to /api/cron/*
CRON_SECRET=
SENTRY_DSN=

# AI (card statements, shared bills, categorization, chat): gateway, gemini or fake
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL_ID=
AI_GATEWAY_API_KEY=
AI_GATEWAY_FALLBACK_MODEL=
BRL_PER_USD=
# AI chat: kill switch, daily quota per tenant, and the bounds of one turn
CHAT_ENABLED=true
CHAT_DAILY_TURN_LIMIT=100
CHAT_DAILY_COST_LIMIT_CENTS=200
CHAT_MAX_ROUNDS=6
CHAT_TURN_BUDGET_MS=25000

# Provider credentials. Each is optional and can also be saved from the app,
# sealed in the database, which wins over the variable (docs/providers.md).

# Open Finance (Pluggy). The _2 pair is an optional second Pluggy account.
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
PLUGGY_CLIENT_ID_2=""
PLUGGY_CLIENT_SECRET_2=""
# Intraday preview feed between Pluggy's daily collections.
PIERRE_API_KEY=""

# Payment rails
ASAAS_API_KEY=""
ASAAS_ENVIRONMENT=
INTER_CLIENT_ID=""
INTER_CLIENT_SECRET=""
INTER_ENVIRONMENT=
INTER_ACCOUNT=
INTER_CERT=
INTER_KEY=
C6_CLIENT_ID=""
C6_CLIENT_SECRET=""
C6_ENVIRONMENT=
C6_TOKEN_URL=
C6_CERT=
C6_KEY=
C6_UPLOADER_NAME=

# Gmail capture: GMAIL_REDIRECT_URI is <api>/api/v1/capture/mailboxes/oauth/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Invoices (Notaas)
NOTAAS_API_KEY=""
NOTAAS_WEBHOOK_SECRET=
NOTAAS_ALIQUOTA_ISS=
NOTAAS_LOCAL_PRESTACAO=
NOTAAS_EXPORT_COUNTRY=

# Webhook secrets (see docs/providers.md); NAME@<entityId> in the app wins
ASAAS_WEBHOOK_TOKEN=
INTER_WEBHOOK_TOKEN=
PLUGGY_WEBHOOK_SECRET=

# Push notifications
FCM_SERVICE_ACCOUNT_JSON=
